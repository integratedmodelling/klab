<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.integratedmodelling</groupId>
		<artifactId>products</artifactId>
		<version>0.11.0-SNAPSHOT</version>
	</parent>
	<artifactId>cli</artifactId>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
							<excludeArtifactIds>javax.annotation</excludeArtifactIds>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-antrun-plugin</artifactId>
			    <version>3.1.0</version>
			    <executions>
			        <execution>
			            <id>strip-commons-io-from-oms</id>
			            <phase>prepare-package</phase>
			            <configuration>
			                <target>
			                    <mkdir dir="${project.build.directory}/oms-unpacked"/>
			                    <unzip
			                        src="${project.build.directory}/lib/oms-3.5.12.jar"
			                        dest="${project.build.directory}/oms-unpacked"/>
			                    <delete dir="${project.build.directory}/oms-unpacked/org/apache/commons/io"/>
			                    <delete dir="${project.build.directory}/oms-unpacked/META-INF/maven/commons-io"/>
			                    <delete>
			                        <fileset dir="${project.build.directory}/oms-unpacked/META-INF">
			                            <include name="*.SF"/>
			                            <include name="*.RSA"/>
			                            <include name="*.DSA"/>
			                        </fileset>
			                    </delete>
			                    <jar
			                        destfile="${project.build.directory}/lib/oms-3.5.12-clean.jar"
			                        basedir="${project.build.directory}/oms-unpacked"
			                        manifest="${project.build.directory}/oms-unpacked/META-INF/MANIFEST.MF"
			                        excludes="META-INF/MANIFEST.MF"/>
			                    <move
			                        file="${project.build.directory}/lib/oms-3.5.12-clean.jar"
			                        tofile="${project.build.directory}/lib/oms-3.5.12.jar"
			                        overwrite="true"/>
			                    <delete dir="${project.build.directory}/oms-unpacked"/>
			                </target>
			            </configuration>
			            <goals>
			                <goal>run</goal>
			            </goals>
			        </execution>
			    </executions>
			</plugin>
			<plugin>
				<groupId>com.google.cloud.tools</groupId>
				<artifactId>jib-maven-plugin</artifactId>
				<configuration>
					<!-- we don't want jib to execute on this module -->
					<skip>true</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.4.0</version>
				<configuration>
					<mainClass>org.integratedmodelling.klab.k.Main</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>

